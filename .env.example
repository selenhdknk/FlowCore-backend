# FlowCore Backend - Ortam Değişkenleri
# Bu dosyayı kopyalayarak .env adıyla kaydedin ve gerçek değerleri doldurun

# =====================================================
# SUNUCU AYARLARI
# =====================================================
PORT=3000
NODE_ENV=development

# =====================================================
# FIREBASE ADMIN SDK
# =====================================================
# Yöntem 1: serviceAccountKey.json dosyası (önerilen)
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

# Yöntem 2: Tek tek ortam değişkenleri olarak (Yöntem 1 yoksa kullanılır)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# =====================================================
# GÜVENLİK AYARLARI
# =====================================================
# Beyaz listedeki client URL'leri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:3000

# Rate limit (dakika başına max istek)
RATE_LIMIT_MAX=100
